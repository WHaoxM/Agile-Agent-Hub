# Agile-Agent Hub 环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值

# ==================== LLM 配置 ====================

# LLM API 密钥（必需）
# 您的 OpenAI API 密钥或兼容服务的 API 密钥
LLM_API_KEY=your-api-key-here

# LLM API 基础地址（可选）
# 如果使用 OpenAI 官方 API，可省略此配置
# 如果使用第三方兼容服务，请填入对应的 API 地址
# 示例：https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型名称（可选，默认：gpt-3.5-turbo）
# 可以根据需要选择不同的模型
# 示例：gpt-4, gpt-3.5-turbo, claude-3-opus 等
LLM_MODEL=gpt-3.5-turbo

# LLM 请求超时时间（可选，默认：30）
# 单位：秒
LLM_TIMEOUT=30
